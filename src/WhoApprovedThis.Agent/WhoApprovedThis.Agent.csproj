<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishAot>true</PublishAot>
    <StripSymbols>true</StripSymbols>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- Local-only: Homebrew OpenSSL for the macOS AOT link; deploy builds target linux-arm64 -->
  <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('osx'))">
    <LinkerArg Include="-L/opt/homebrew/opt/openssl@3/lib" />
    <LinkerArg Include="-L/opt/homebrew/opt/brotli/lib" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.BedrockAgentCore" Version="4.0.103" />
    <PackageReference Include="AWSSDK.BedrockRuntime" Version="4.0.101" />
    <PackageReference Include="ModelContextProtocol.Core" Version="1.4.0" />
  </ItemGroup>

</Project>
